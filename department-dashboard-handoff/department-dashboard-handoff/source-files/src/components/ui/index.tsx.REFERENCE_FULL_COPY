"use client";

import React from "react";

/* ─── Button ─── */
type ButtonVariant = "primary" | "secondary" | "ghost" | "danger" | "accent";
type ButtonSize = "sm" | "md" | "lg";

interface ButtonProps extends React.ButtonHTMLAttributes<HTMLButtonElement> {
  variant?: ButtonVariant;
  size?: ButtonSize;
  loading?: boolean;
  icon?: React.ReactNode;
  fullWidth?: boolean;
}

const buttonStyles: Record<ButtonVariant, string> = {
  primary:
    "bg-text-primary text-canvas hover:bg-[#d8d8db] active:bg-[#c0c0c4]",
  secondary:
    "bg-surface-2 text-text-primary border border-border hover:bg-surface-3 hover:border-border-hover active:bg-surface-4",
  ghost:
    "bg-transparent text-text-secondary hover:text-text-primary hover:bg-surface-1 active:bg-surface-2",
  danger:
    "bg-error-bg text-error border border-error-border hover:bg-[rgba(239,68,68,0.18)] active:bg-[rgba(239,68,68,0.25)]",
  accent:
    "bg-accent text-white hover:bg-accent-hover active:bg-[#3b7ae3]",
};

const buttonSizes: Record<ButtonSize, string> = {
  sm: "px-3 py-1.5 text-xs gap-1.5 min-h-[32px]",
  md: "px-5 py-2.5 text-sm gap-2 min-h-[44px]",
  lg: "px-7 py-3 text-base gap-2.5 min-h-[52px]",
};

export function Button({
  variant = "primary",
  size = "md",
  loading = false,
  icon,
  fullWidth = false,
  children,
  disabled,
  className = "",
  ...props
}: ButtonProps) {
  return (
    <button
      disabled={disabled || loading}
      className={`
        inline-flex items-center justify-center font-medium
        rounded-pill transition-all duration-[var(--transition-fast)]
        focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-2
        disabled:opacity-40 disabled:cursor-not-allowed
        cursor-pointer select-none
        ${buttonStyles[variant]}
        ${buttonSizes[size]}
        ${fullWidth ? "w-full" : ""}
        ${className}
      `}
      {...props}
    >
      {loading ? (
        <svg
          className="animate-spin h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          aria-label="Loading"
        >
          <circle
            className="opacity-25"
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            strokeWidth="4"
          />
          <path
            className="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"
          />
        </svg>
      ) : icon ? (
        <span className="flex-shrink-0">{icon}</span>
      ) : null}
      {children}
    </button>
  );
}

/* ─── Badge ─── */
type BadgeVariant =
  | "default"
  | "critical"
  | "high"
  | "medium"
  | "low"
  | "success"
  | "warning"
  | "error"
  | "accent";

interface BadgeProps {
  variant?: BadgeVariant;
  children: React.ReactNode;
  icon?: React.ReactNode;
  className?: string;
}

const badgeStyles: Record<BadgeVariant, string> = {
  default: "bg-surface-2 text-text-secondary border-border",
  critical: "bg-critical-bg text-critical border-critical-border",
  high: "bg-high-bg text-high border-high-border",
  medium: "bg-medium-bg text-medium border-medium-border",
  low: "bg-low-bg text-low border-low-border",
  success: "bg-success-bg text-success border-success-border",
  warning: "bg-warning-bg text-warning border-warning-border",
  error: "bg-error-bg text-error border-error-border",
  accent: "bg-accent-muted text-accent border-[rgba(77,140,245,0.25)]",
};

export function Badge({
  variant = "default",
  children,
  icon,
  className = "",
}: BadgeProps) {
  return (
    <span
      className={`
        inline-flex items-center gap-1.5 px-2.5 py-1
        text-xs font-medium rounded-pill border
        ${badgeStyles[variant]}
        ${className}
      `}
    >
      {icon && <span className="flex-shrink-0 w-3 h-3">{icon}</span>}
      {children}
    </span>
  );
}

/* ─── Card ─── */
interface CardProps extends React.HTMLAttributes<HTMLDivElement> {
  variant?: "default" | "elevated" | "gradient" | "interactive";
  padding?: "none" | "sm" | "md" | "lg";
}

const cardPadding = {
  none: "",
  sm: "p-4",
  md: "p-6",
  lg: "p-8",
};

export function Card({
  variant = "default",
  padding = "md",
  children,
  className = "",
  ...props
}: CardProps) {
  const variantClass = {
    default: "bg-surface-1 border border-border rounded-card",
    elevated:
      "bg-surface-1 border border-border rounded-card shadow-md",
    gradient: "gradient-card",
    interactive:
      "bg-surface-1 border border-border rounded-card hover:border-border-hover hover:bg-surface-2 transition-all duration-[var(--transition-base)] cursor-pointer",
  }[variant];

  return (
    <div className={`${variantClass} ${cardPadding[padding]} ${className}`} {...props}>
      {children}
    </div>
  );
}

/* ─── Input ─── */
interface InputProps extends React.InputHTMLAttributes<HTMLInputElement> {
  label?: string;
  error?: string;
  hint?: string;
  icon?: React.ReactNode;
}

export const Input = React.forwardRef<HTMLInputElement, InputProps>(
  ({ label, error, hint, icon, className = "", id, ...props }, ref) => {
    const inputId = id || `input-${label?.toLowerCase().replace(/\s/g, "-")}`;
    return (
      <div className="flex flex-col gap-1.5">
        {label && (
          <label
            htmlFor={inputId}
            className="text-sm font-medium text-text-secondary"
          >
            {label}
          </label>
        )}
        <div className="relative">
          {icon && (
            <span className="absolute left-3 top-1/2 -translate-y-1/2 text-text-tertiary">
              {icon}
            </span>
          )}
          <input
            ref={ref}
            id={inputId}
            className={`
              w-full bg-surface-1 border rounded-md
              px-4 py-2.5 text-sm text-text-primary
              placeholder:text-text-tertiary
              transition-colors duration-[var(--transition-fast)]
              focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent
              disabled:opacity-40 disabled:cursor-not-allowed
              ${icon ? "pl-10" : ""}
              ${error ? "border-error" : "border-border hover:border-border-hover"}
              ${className}
            `}
            aria-invalid={!!error}
            aria-describedby={
              error ? `${inputId}-error` : hint ? `${inputId}-hint` : undefined
            }
            {...props}
          />
        </div>
        {error && (
          <p id={`${inputId}-error`} className="text-xs text-error" role="alert">
            {error}
          </p>
        )}
        {hint && !error && (
          <p id={`${inputId}-hint`} className="text-xs text-text-tertiary">
            {hint}
          </p>
        )}
      </div>
    );
  }
);

Input.displayName = "Input";

